# TouchDesigner's Movie File Out writes here by default, outside Movie/, and
# the raw MJPEG renders run to hundreds of MB — past GitHub's 100MB file limit.
# The web-sized derivative lives in docs/media/.
InWard Bound System/TDMovieOut*
*.mov
/package-lock.json

InWard Bound System/Backup/

# TouchDesigner writes a numbered .toe on every incremental save. Only the
# current file is tracked; the numbered snapshots are local history.
InWard Bound System/*.[0-9].toe
InWard Bound System/*.[0-9][0-9].toe
InWard Bound System/*.[0-9][0-9][0-9].toe

# Web-delivery copies of the documentation video (33MB) — generated from the
# source in Movie/ with ffmpeg, see docs/index.html
!docs/media/

# Camera-original recordings dropped into docs/ for encoding. The web-delivery
# copies live in docs/media/ and are tracked; the originals are hundreds of MB
# and exceed GitHub's 100MB per-file limit.
docs/*.mp4
docs/*.mov
docs/*.MP4
docs/*.MOV
